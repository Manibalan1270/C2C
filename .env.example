VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- scripts/ only (never VITE_-prefixed — must not ship to the browser) ---
# Paste the full JSON contents of a downloaded service-account key as a
# single-line string (Firebase Console > Project settings > Service
# accounts > Generate new private key). This is also the exact shape the
# GitHub Actions secret for the sync engine will use later.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- On-demand sync ("Refresh my stats") -------------------------------
# Base URL of the deployed serverless function, e.g. https://c2c-sync.vercel.app
# Leave blank and the Refresh button hides itself — the 15-minute cron still runs.
# This is a public URL, so VITE_ is correct here. The SERVICE ACCOUNT must
# never be a VITE_ var: Vite inlines those into the browser bundle.
VITE_SYNC_API_URL=

# --- Vercel (server-side only, NEVER prefixed VITE_) --------------------
# Set these in the Vercel project's environment variables, not here.
#   FIREBASE_SERVICE_ACCOUNT_JSON   the key file contents, one line
#   SYNC_ALLOWED_ORIGINS            comma-separated origins allowed to call
#                                   /api/sync, e.g. https://c2cclub.in
#                                   The Firebase *.web.app domains and
#                                   localhost are always allowed.
