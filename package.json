{
  "name": "c2c-scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "tsx scripts/seedFirestore.ts",
    "seed:demo": "tsx scripts/seedFirestore.ts --demo",
    "promote": "tsx scripts/promoteAdmin.ts",
    "sync": "tsx scripts/syncPlatforms.ts",
    "check:sync": "tsx scripts/__checks__/streak.check.ts && tsx scripts/__checks__/award.check.ts && tsx scripts/__checks__/challengeMatch.check.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "check:rules": "firebase emulators:exec --only firestore \"tsx scripts/__checks__/rules.check.ts\"",
    "check:security": "tsx scripts/__checks__/liveRules.check.ts",
    "check:all": "npm run lint && tsc -b && npm run check:sync && npm run check:security"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.25.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
